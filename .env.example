# Log2 Alfa Userbot - .env örneği
# Bu dosyayı kopyala -> .env yap ve doldur

# === ZORUNLU: BotFather'dan al ===
# @BotFather -> /newbot -> isim ver -> token kopyala
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === ZORUNLU: my.telegram.org ===
# https://my.telegram.org -> Log in -> API Development Tools -> Create App
# App title: Log2 Alfa | Short name: log2alfa | Platform: Other
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef0123456789abcdef

# === OPSIYONEL ===
# Sadece senin ID'n kullansın istiyorsan ( @userinfobot ile al )
# 0 bırakırsan herkes kendi hesabıyla giriş yapabilir
OWNER_ID=8722368605

# Sahip görünen isim/link (panelde gösterilir)
OWNER_NAME=vayko
OWNER_URL=https://t.me/vaykoo

# Destek / Geliştirici butonları (botun /start menüsünde çıkar)
# Boş bırakırsan buton gizlenir
SUPPORT_URL=  # KAPALI - boş bırak
DEV_URL=https://t.me/vaykoo

# Admin paneli için ekstra yetkili ID ve kullanıcı adları (virgülle ayır)
# Örn: ADMIN_UID=123456789
# Örn: ADMIN_USERNAMES=user1,user2
ADMIN_UID=8722368605
ADMIN_USERNAMES=vaykoo

# Veritabanı / Session klasörü
DATABASE_PATH=log2alfa.db
WORKDIR=./sessions

# Log kanalı (opsiyonel, userbot loglarının gideceği kanal)
# Boş bırakılabilir
SUPPORT_CHAT_ID=
LOG_CHANNEL=

# AI KALDIRILDI - .ai komutu devre dışı
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
